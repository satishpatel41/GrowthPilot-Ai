# Database
DATABASE_URL=postgresql://growthpilot:growthpilot@localhost:5432/growthpilot

# API
PORT=4000
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-characters
WEB_ORIGIN=http://localhost:3000
SESSION_HOURS=12
BCRYPT_ROUNDS=12
# Development only: echo OTP codes in API responses (ignored in production)
OTP_DEV_ECHO=true
