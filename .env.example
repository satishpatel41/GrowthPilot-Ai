# First Super Admin (used by `pnpm --filter @growthpilot/api seed`)
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=ChangeMe-Please-123

# Web
API_URL=http://localhost:4000
